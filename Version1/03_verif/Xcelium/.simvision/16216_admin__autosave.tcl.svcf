
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set cursorctl-dont-show-sync-warning 1
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0

#
# Databases
#
database require tb_PA_Cal_Mean -search {
	../PACM_UNIT/Xcelium/tb_PA_Cal_Mean.shm/tb_PA_Cal_Mean.trn
	/home/admin/shared/project_tiny/BigProject/Sort_on_FPGA/Version1/03_verif/PACM_UNIT/Xcelium/tb_PA_Cal_Mean.shm/tb_PA_Cal_Mean.trn
}

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1918x811+0+31}] != ""} {
    window geometry "Waveform 1" 1918x811+0+31
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	{tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.a_value_i[31:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.w_a_value[31:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.b_value_i[31:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.w_b_value[31:0]}
	} ]
set id [waveform add -signals  {
	tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.i_start
	} ]
set id [waveform add -signals  {
	{tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.z_value_o[31:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.w_z_value[31:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.state[3:0]}
	} ]
set id [waveform add -signals  {
	tb_PA_Cal_Mean::tb_PA_Cal_Mean.DUT.FPU32_DIV_UNIT.o_done
	} ]

waveform xview limits 207090.299ns 207470ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 600x250+0+0
