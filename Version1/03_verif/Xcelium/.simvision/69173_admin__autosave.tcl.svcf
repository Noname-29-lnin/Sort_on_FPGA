
#
# Preferences
#
preferences set toolbar-Standard-WatchWindow {
  usual
  shown 0
}
preferences set plugin-enable-svdatabrowser-new 1
preferences set cursorctl-dont-show-sync-warning 1
preferences set toolbar-Windows-WatchWindow {
  usual
  shown 0
}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbar-SimControl-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}

#
# Databases
#
database require tb_PA_mem -search {
	../PAMEM_UNIT/Xcelium/tb_PA_mem.shm/tb_PA_mem.trn
	/home/admin/shared/My_project/Sort_on_FPGA/Version1/03_verif/PAMEM_UNIT/Xcelium/tb_PA_mem.shm/tb_PA_mem.trn
}

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1904x795+0+31}] != ""} {
    window geometry "Waveform 1" 1904x795+0+31
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.i_clk
	} ]
set id [waveform add -signals  {
	tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.i_rst_n
	} ]
set id [waveform add -signals  {
	tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.i_start
	} ]
set id [waveform add -signals  {
	{tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.i_addr_a[10:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.i_addr_b[10:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.i_data_a[31:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.i_data_b[31:0]}
	} ]
set id [waveform add -signals  {
	tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.o_wr_ram
	} ]
set id [waveform add -signals  {
	{tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.o_addr_ram[10:0]}
	} ]
set id [waveform add -signals  {
	{tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.o_data_ram[31:0]}
	} ]
set id [waveform add -signals  {
	tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.PAMEM_WRITEDATA_UNIT.o_done
	} ]
set id [waveform add -signals  {
	tb_PA_mem::tb_PA_mem.DUT.PAMEM_SWAP.w_start_range
	} ]

waveform xview limits 0 2000ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 600x250+0+0
